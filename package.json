{
  "name": "skillmd",
  "version": "0.0.0",
  "private": true,
  "description": "The SkillMD toolchain: SKILL.md lint engine (@skillmds/core), the skillmd CLI, and the skillmds MCP server.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build -w @skillmds/core && npm run build -w skillmds",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @skillmds/core && npm test --workspaces --if-present",
    "lint:skills": "node packages/skillmds/bin/skillmd.mjs lint examples/skills"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillmds/skillmd.git"
  },
  "homepage": "https://skillmd.com",
  "bugs": {
    "url": "https://github.com/skillmds/skillmd/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
